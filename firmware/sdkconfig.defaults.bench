CONFIG_MAGNIBOT_ESTOP_GPIO=6
CONFIG_MAGNIBOT_BENCH_SERVO=y
CONFIG_MAGNIBOT_SERVO_MAX_DPS=90
CONFIG_MAGNIBOT_BASE_SCAN=y
CONFIG_MAGNIBOT_TOF=y
# CONFIG_MAGNIBOT_TOF_DIAGNOSTIC is not set
# CONFIG_MAGNIBOT_UART_COMMANDS is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MAGNIBOT_SHOULDER_MIN_US=500
CONFIG_MAGNIBOT_SHOULDER_MAX_US=2500
